{
  "entities": {
    "UserAccount": {
      "title": "UserAccount",
      "description": "Private authenticated user profile, solved proof IDs, aggregate mastery counts, and timer preference",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "displayName": { "type": "string", "maxLength": 128 },
        "email": { "type": "string", "maxLength": 256 },
        "photoURL": { "type": "string", "maxLength": 512 },
        "solvedExerciseIds": {
          "type": "array",
          "items": { "type": "string", "maxLength": 64 }
        },
        "verifiedCount": { "type": "number" },
        "struggledCount": { "type": "number" },
        "defaultTimerMinutes": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "uid",
        "displayName",
        "email",
        "photoURL",
        "solvedExerciseIds",
        "verifiedCount",
        "struggledCount",
        "defaultTimerMinutes",
        "createdAt",
        "updatedAt"
      ]
    },
    "Track": {
      "title": "Track",
      "description": "Curated proof-based mathematics track",
      "type": "object",
      "properties": {
        "slug": { "type": "string", "maxLength": 64 },
        "title": { "type": "string", "maxLength": 128 },
        "description": { "type": "string", "maxLength": 512 },
        "orderIndex": { "type": "number" }
      },
      "required": ["slug", "title", "description", "orderIndex"]
    },
    "Exercise": {
      "title": "Exercise",
      "description": "Curated proof problem with Basic/Advanced level and step-by-step derivation",
      "type": "object",
      "properties": {
        "trackId": { "type": "string", "maxLength": 64 },
        "level": { "type": "string", "enum": ["basic", "advanced"] },
        "title": { "type": "string", "maxLength": 128 },
        "latexStatement": { "type": "string", "maxLength": 4096 },
        "targetSolution": { "type": "string", "maxLength": 2048 },
        "solvingSequences": { "type": "array" }
      },
      "required": ["trackId", "level", "title", "latexStatement", "targetSolution", "solvingSequences"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserAccount",
      "description": "Owner-only user profile, solved proofs list, rank metrics, and timer preference"
    },
    "/tracks/{trackId}": {
      "schema": "Track",
      "description": "Public read-only tracks list"
    },
    "/exercises/{exerciseId}": {
      "schema": "Exercise",
      "description": "Public read-only curated exercises"
    }
  }
}
