rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all access
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Topics: Curated and immutable for clients
    match /topics/{topicId} {
      allow get, list: if isValidId(topicId);
      allow write: if false;
    }

    // Exercises: Read-only curated library. Users cannot modify exercises.
    match /exercises/{exerciseId} {
      allow get, list: if isValidId(exerciseId);
      allow write: if false;
    }

    // History logs: Users log their success / fail attempts
    match /history_logs/{logId} {
      allow get, list: if true;
      allow create: if isValidId(logId) &&
        incoming().keys().hasAll(['exerciseId', 'outcome', 'pointsEarned', 'timeSpentSeconds', 'timestamp']) &&
        incoming().exerciseId is string && incoming().exerciseId.size() <= 64 &&
        (incoming().outcome == 'success' || incoming().outcome == 'failed') &&
        incoming().pointsEarned is number && incoming().pointsEarned >= 0 &&
        incoming().timeSpentSeconds is number && incoming().timeSpentSeconds >= 0 &&
        incoming().timestamp is string && incoming().timestamp.size() <= 64;
      allow update, delete: if false;
    }
  }
}
