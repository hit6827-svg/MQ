rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global safety net: Default deny all access
    match /{document=**} {
      allow read, write: if false;
    }

    // Hardened Global Helpers
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Validation Blueprint: UserAccount
    function isValidUserAccount(data, userId) {
      return data.keys().hasAll([
        'uid', 'displayName', 'email', 'photoURL',
        'scheduleStartedAt', 'scheduleFastForwardHours',
        'createdAt', 'updatedAt'
      ]) &&
      data.keys().hasOnly([
        'uid', 'displayName', 'email', 'photoURL',
        'scheduleStartedAt', 'scheduleFastForwardHours',
        'createdAt', 'updatedAt'
      ]) &&
      data.uid is string && data.uid == userId && data.uid.size() <= 128 &&
      data.displayName is string && data.displayName.size() <= 128 &&
      data.email is string && data.email.size() <= 256 &&
      data.photoURL is string && data.photoURL.size() <= 512 &&
      data.scheduleStartedAt is number && data.scheduleStartedAt >= 0 &&
      data.scheduleFastForwardHours is number && data.scheduleFastForwardHours >= 0 &&
      data.createdAt is timestamp &&
      data.updatedAt is timestamp;
    }

    // Validation Blueprint: HistoryLog
    function isValidHistoryLog(data) {
      return data.keys().hasAll([
        'userId', 'exerciseId', 'exerciseTitle', 'topicId',
        'outcome', 'pointsEarned', 'timeSpentSeconds',
        'timestamp', 'createdAt'
      ]) &&
      data.keys().hasOnly([
        'userId', 'exerciseId', 'exerciseTitle', 'topicId',
        'outcome', 'pointsEarned', 'timeSpentSeconds',
        'timestamp', 'createdAt'
      ]) &&
      data.userId is string && data.userId == request.auth.uid && data.userId.size() <= 128 &&
      data.exerciseId is string && data.exerciseId.size() <= 64 &&
      data.exerciseTitle is string && data.exerciseTitle.size() <= 128 &&
      data.topicId is string && data.topicId.size() <= 64 &&
      (data.outcome == 'success' || data.outcome == 'failed') &&
      data.pointsEarned is number && data.pointsEarned >= 0 &&
      data.timeSpentSeconds is number && data.timeSpentSeconds >= 0 &&
      data.timestamp is string && data.timestamp.size() <= 64 &&
      data.createdAt is timestamp;
    }

    // User Account & Schedule: Strictly owner-only PII isolation, no list queries allowed
    match /users/{userId} {
      allow get: if isValidId(userId) && isOwner(userId);
      allow list: if false;
      allow create: if isVerified() && isValidId(userId) && isOwner(userId) &&
        isValidUserAccount(incoming(), userId) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;
      allow update: if isVerified() && isValidId(userId) && isOwner(userId) &&
        isValidUserAccount(incoming(), userId) &&
        incoming().uid == existing().uid &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'displayName', 'email', 'photoURL',
          'scheduleStartedAt', 'scheduleFastForwardHours', 'updatedAt'
        ]);
      allow delete: if false;
    }

    // Topics: Curated and immutable for clients
    match /topics/{topicId} {
      allow get: if isValidId(topicId);
      allow list: if true;
      allow write: if false;
    }

    // Exercises: Read-only curated library. Users cannot modify exercises.
    match /exercises/{exerciseId} {
      allow get: if isValidId(exerciseId);
      allow list: if true;
      allow write: if false;
    }

    // History logs: Owner-only read/query/create, immutable once logged
    match /history_logs/{logId} {
      allow get: if isSignedIn() && isValidId(logId) && existing().userId == request.auth.uid;
      allow list: if isSignedIn() && existing().userId == request.auth.uid;
      allow create: if isVerified() && isValidId(logId) &&
        isValidHistoryLog(incoming()) &&
        incoming().createdAt == request.time;
      allow update, delete: if false;
    }
  }
}
