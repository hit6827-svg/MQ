rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global safety net: Default deny all access
    match /{document=**} {
      allow read, write: if false;
    }

    // Hardened Global Helpers
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Validation Blueprint: UserAccount
    function isValidUserAccount(data, userId) {
      return data.keys().hasAll([
        'uid', 'displayName', 'email', 'photoURL',
        'solvedExerciseIds', 'verifiedCount', 'struggledCount', 'defaultTimerMinutes',
        'createdAt', 'updatedAt'
      ]) &&
      data.keys().hasOnly([
        'uid', 'displayName', 'email', 'photoURL',
        'solvedExerciseIds', 'verifiedCount', 'struggledCount', 'defaultTimerMinutes',
        'createdAt', 'updatedAt'
      ]) &&
      data.uid is string && data.uid == userId && data.uid.size() <= 128 &&
      data.displayName is string && data.displayName.size() <= 128 &&
      data.email is string && data.email.size() <= 256 &&
      data.photoURL is string && data.photoURL.size() <= 512 &&
      data.solvedExerciseIds is list && data.solvedExerciseIds.size() <= 50 &&
      (data.solvedExerciseIds.size() == 0 || data.solvedExerciseIds[0] is string) &&
      data.verifiedCount is number && data.verifiedCount >= 0 &&
      data.struggledCount is number && data.struggledCount >= 0 &&
      data.defaultTimerMinutes is number && data.defaultTimerMinutes >= 0 && data.defaultTimerMinutes <= 180 &&
      data.createdAt is timestamp &&
      data.updatedAt is timestamp;
    }

    // User Account & Proof Progression: Strictly owner-only isolation, no list queries
    match /users/{userId} {
      allow get: if isValidId(userId) && isOwner(userId);
      allow list: if false;
      allow create: if isVerified() && isValidId(userId) && isOwner(userId) &&
        isValidUserAccount(incoming(), userId) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;
      allow update: if isVerified() && isValidId(userId) && isOwner(userId) &&
        isValidUserAccount(incoming(), userId) &&
        incoming().uid == existing().uid &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time && (
          incoming().diff(existing()).affectedKeys().hasOnly([
            'displayName', 'email', 'photoURL',
            'solvedExerciseIds', 'verifiedCount', 'struggledCount', 'defaultTimerMinutes',
            'updatedAt'
          ]) || (
            existing().keys().hasAny(['scheduleStartedAt', 'scheduleFastForwardHours']) &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'displayName', 'email', 'photoURL',
              'solvedExerciseIds', 'verifiedCount', 'struggledCount', 'defaultTimerMinutes',
              'scheduleStartedAt', 'scheduleFastForwardHours',
              'updatedAt'
            ])
          )
        );
      allow delete: if false;
    }

    // Tracks: Curated and immutable for clients
    match /tracks/{trackId} {
      allow get: if isValidId(trackId);
      allow list: if true;
      allow write: if false;
    }

    // Exercises: Read-only curated library
    match /exercises/{exerciseId} {
      allow get: if isValidId(exerciseId);
      allow list: if true;
      allow write: if false;
    }
  }
}
